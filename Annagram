

public class anagram{
    public static boolean isAnagram(String x, String y){
        int[] data =new int[256];

        for(int j=0;j<x.length();j++){
            if(x.charAt(j)!=' '&&x.charAt(j)>'A'&&x.charAt(j)<'Z'){
                data[x.charAt(j)+32]+=1;
            }
            else if(x.charAt(j)!=' '&&x.charAt(j)>'a'&&x.charAt(j)<'z'){
                data[x.charAt(j)]+=1;
            }
        }

        for(int j=0;j<y.length();j++){
            if(y.charAt(j)!=' '&&y.charAt(j)>'A'&&y.charAt(j)<'Z'){
                data[y.charAt(j)+32]+=-1;
            }
            else if(y.charAt(j)!=' '&&y.charAt(j)>'a'&&y.charAt(j)<'z'){
                data[y.charAt(j)]+=-1;
            }
        }

        for(int i=0;i<256;i++){
            if(data[i]!=0){
                return false;
            }
        }

        return true;
    }
    static void main(){
        System.out.println(isAnagram("Listen","silent"));
    }
}
